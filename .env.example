# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never paste real values into chat or commit them to GitHub.

# Neon database connection string (Neon dashboard → Connect → copy the "pooled" connection string)
DATABASE_URL=

# Any long random text (at least 32 characters). Used to sign login sessions.
AUTH_SECRET=

# Your live website address, no slash at the end
SITE_URL=https://markiqsi.com

# Resend (for login emails)
RESEND_API_KEY=
EMAIL_FROM=MarkIQ SI <login@markiqsi.com>

# Gemini (for Ask MarkIQ and reading strategies written in plain words)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Twelve Data (price data for the Market Scanner and backtests)
TWELVE_DATA_API_KEY=

# Telegram (same bot as the market bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Secret the market bot sends when it calls /api/cron/scanner (any long random text)
CRON_SECRET=

# Twelve Data plan limits (free plan: 8 a minute, 800 a day). Raise these if you upgrade.
TWELVE_DATA_PER_MINUTE=8
TWELVE_DATA_PER_DAY=800
# Set to "on" (only on a paid data plan) to refresh 1m–30m charts for every market automatically
SCANNER_FAST=off
